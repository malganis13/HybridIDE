// Ресурсы Windows: информация о версии (манифест подключается через CMake,
// чтобы линкер MSVC объединил его со своим, без дубликата ресурса).
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041904B0"
        BEGIN
            VALUE "CompanyName",      "malganis13"
            VALUE "FileDescription",  "HybridIDE"
            VALUE "FileVersion",      "@PROJECT_VERSION@"
            VALUE "ProductName",      "HybridIDE"
            VALUE "ProductVersion",   "@PROJECT_VERSION@"
            VALUE "OriginalFilename", "HybridIDE.exe"
            VALUE "LegalCopyright",   "MIT License"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x419, 1200
    END
END
